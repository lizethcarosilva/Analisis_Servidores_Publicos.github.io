		<properties node_id="7" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07\x80\x00\x00\x04\x08\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x07\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x07', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'from Orange.data import Table, Domain, ContinuousVariable\nimport numpy as np\n\n# Lista de columnas a sumar\ncolumnas_a_sumar = [\n    "Meses de Experiencia Público",\n    "Meses de Experiencia Privado",\n    "Meses de Experiencia Docente"\n]\n\n# Buscar las columnas en metas y extraer los valores reales\nvalores_sumar = []\n\nfor nombre_col in columnas_a_sumar:\n    encontrada = False\n\n    # Buscar en atributos (X)\n    for i, var in enumerate(in_data.domain.attributes):\n        if var.name == nombre_col:\n            col_vals = in_data.X[:, i]\n            encontrada = True\n            break\n\n    # Buscar en metas\n    if not encontrada:\n        for i, var in enumerate(in_data.domain.metas):\n            if var.name == nombre_col:\n                col_vals = in_data.metas[:, i]\n                encontrada = True\n                break\n\n    if not encontrada:\n        raise ValueError(f"No se encontró la columna \'{nombre_col}\' en X ni en metas.")\n\n    # Convertir todos los valores a números reales (por si son texto)\n    col_vals = np.array([float(val) if str(val).strip() != "" else np.nan for val in col_vals])\n    valores_sumar.append(col_vals)\n\n# Convertir a matriz y sumar por filas\nvalores_sumar = np.array(valores_sumar).T\nsuma_total = np.nansum(valores_sumar, axis=1).reshape(-1, 1)\n\n# Crear la nueva variable\nnueva_variable = ContinuousVariable("valor total experiencia (Meses)")\nnuevo_domain = Domain(\n    in_data.domain.attributes + (nueva_variable,),\n    in_data.domain.class_vars,\n    in_data.domain.metas\n)\n\n# Agregar la columna nueva al final de X\nnuevos_X = np.hstack((in_data.X, suma_total))\n\n# Crear la nueva tabla con el valor total\nnueva_tabla = Table(nuevo_domain, nuevos_X, in_data.Y, in_data.metas)\n\n# Salida final\nout_data = nueva_tabla\n\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x01\x9e\x00\x00\x00\xc3\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="8" format="pickle">gASVzREAAAAAAAB9lCiMC2F1dG9fY29tbWl0lIiMEmNvbnRyb2xBcmVhVmlzaWJsZZSIjBNpZ25v
