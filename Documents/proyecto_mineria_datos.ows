		<properties node_id="9" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07\x80\x00\x00\x04\x08\x00\x00\x023\x00\x00\x00R\x00\x00\x06\x10\x00\x00\x03\x12\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x07', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import numpy as np\nimport pandas as pd\nfrom Orange.data import Table, Domain\n\n# Convertir partes a DataFrames\nattrs = [var.name for var in in_data.domain.attributes]\nclass_vars = [var.name for var in in_data.domain.class_vars]\nmetas = [var.name for var in in_data.domain.metas]\n\ndf_attrs = pd.DataFrame(in_data.X, columns=attrs)\ndf_class = pd.DataFrame(in_data.Y, columns=class_vars) if class_vars else pd.DataFrame()\ndf_metas = pd.DataFrame(in_data.metas, columns=metas) if metas else pd.DataFrame()\n\n# Unir todo\ndf_total = pd.concat([df_attrs, df_class, df_metas], axis=1)\n\n# Reemplazar valores tipo texto nulo por np.nan\nvalores_nulos = [\'null\', \'NULL\', \'NaN\', \'nan\', \'None\', \'none\', \'\', \' \']\ndf_total = df_total.replace(valores_nulos, np.nan)\n\n# Convertir a float si se puede (opcional, útil para detectar bien los NaN)\ndf_total = df_total.apply(pd.to_numeric, errors=\'ignore\')\n\n# Eliminar filas con cualquier NaN\ndf_total_clean = df_total.dropna()\n\n# Separar de nuevo\nn_attrs = len(attrs)\nn_class = len(class_vars)\n\ndf_attrs_clean = df_total_clean.iloc[:, :n_attrs]\ndf_class_clean = df_total_clean.iloc[:, n_attrs:n_attrs+n_class] if n_class else None\ndf_metas_clean = df_total_clean.iloc[:, n_attrs+n_class:] if metas else None\n\n# Reconstruir dominio y tabla\ndomain = Domain(in_data.domain.attributes, in_data.domain.class_vars, in_data.domain.metas)\nX_clean = df_attrs_clean.to_numpy()\nY_clean = df_class_clean.to_numpy() if df_class_clean is not None else None\nmetas_clean = df_metas_clean.to_numpy() if df_metas_clean is not None else None\n\nout_data = Table(domain, X_clean, Y_clean, metas_clean)\n\n# Verificación\nprint(f"Filas originales: {len(in_data)}")\nprint(f"Filas después de limpieza: {len(out_data)}")\n\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x01\x9e\x00\x00\x00\xc3\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
